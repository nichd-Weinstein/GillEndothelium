cluster_split = c('99')
gill3$seurat_clusters = Idents(gill3)
gill3$refined_clusters = as.character(Idents(gill3)) # initialization; will be modified
for(cl in cluster_split) {
  
  sub=FindNeighbors(gill3[,Idents(gill3)==cl], reduction = "pca", dims = 1:30)
  sub_res=0.8
  sub=FindClusters(sub, resolution=sub_res)
  l = length(unique(sub$seurat_clusters))
  if(l == 1) {
    sub_res_low=sub_res
    while(l == 1) {
      sub_res = sub_res*2
      sub=FindClusters(sub, resolution=sub_res)
      l = length(unique(sub$seurat_clusters))
    }
    sub_res_high = sub_res
  } else if(l > 2) {
    sub_res_high=sub_res
    while(l > 2) {
      sub_res = sub_res/2
      sub=FindClusters(sub, resolution=sub_res)
      l = length(unique(sub$seurat_clusters))
    }
    sub_res_low = sub_res
  }
  while(l != 2) {
    sub_res = (sub_res_low + sub_res_high)/2
    sub=FindClusters(sub, resolution=sub_res)
    l = length(unique(sub$seurat_clusters))
    if(l == 1) sub_res_low = sub_res else sub_res_high = sub_res
  }
  # append sub-cluster ids:
  gill3$refined_clusters[colnames(sub)] = paste(gill3$refined_clusters[colnames(sub)], sub$seurat_clusters, sep='.')}

